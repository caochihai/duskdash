# PostgreSQL runtime contract for workers
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=bank_ai
DATABASE_USER=bank_worker
DATABASE_PASSWORD=<secret>
DATABASE_URL=postgresql://bank_worker:<secret>@postgres:5432/bank_ai

# Kafka. Set the account/client pair for the deployed worker identity:
# document-worker, analysis-orchestrator, credit-worker, compliance-worker,
# report-worker, notification-gateway, or audit-consumer.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=<service-account>
KAFKA_SASL_PASSWORD=<secret>
KAFKA_CLIENT_ID=<service-account>
KAFKA_CONSUMER_GROUP=<assigned-consumer-group>
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_AUTO_OFFSET_RESET=earliest

# Redis is temporary coordination/cache only, never the job source of truth.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<secret>
REDIS_URL=redis://:<secret>@redis:6379/0
REDIS_KEY_PREFIX=bank-ai

# MinIO. Select only the account assigned to this worker:
# document-worker, policy-worker, report-worker, or audit-writer.
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=<service-account>
MINIO_SECRET_KEY=<secret>
MINIO_SECURE=false

# Service-to-service OIDC
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=bank-ai
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/bank-ai/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=bank-ai-worker
KEYCLOAK_CLIENT_SECRET=<secret>
OIDC_EXPECTED_AUDIENCE=bank-ai-api
