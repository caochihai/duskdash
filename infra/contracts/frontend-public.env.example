# Public browser configuration only. Never place database, Kafka, Redis,
# MinIO access-key, or confidential OIDC client credentials in this file.
# This project uses Vite (not Next.js), so variables must use the VITE_ prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK_API=false
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=bank-ai
VITE_KEYCLOAK_CLIENT_ID=bank-ai-frontend
VITE_APP_NAME=SHB AI Assistant
VITE_APP_ENV=development
