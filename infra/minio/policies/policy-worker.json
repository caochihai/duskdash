{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PolicyBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::policy-documents"
    },
    {
      "Sid": "ReadPolicyDocuments",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::policy-documents/policies/*/versions/*/original.pdf"
    },
    {
      "Sid": "WriteParsedPolicies",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::policy-documents/policies/*/versions/*/parsed.json"
    }
  ]
}

