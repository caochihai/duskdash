{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuditBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::audit-archive"
    },
    {
      "Sid": "AppendAuditBatches",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::audit-archive/audit/*/*/*/events-*.jsonl"
    }
  ]
}
