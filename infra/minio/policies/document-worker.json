{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocumentBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::upload-quarantine",
        "arn:aws:s3:::customer-doc-original",
        "arn:aws:s3:::customer-doc-derived"
      ]
    },
    {
      "Sid": "ReadQuarantineAndOriginal",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::upload-quarantine/uploads/*/incoming",
        "arn:aws:s3:::customer-doc-original/documents/*"
      ]
    },
    {
      "Sid": "WriteOriginalAndDerived",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::customer-doc-original/documents/*",
        "arn:aws:s3:::customer-doc-derived/documents/*"
      ]
    }
  ]
}

