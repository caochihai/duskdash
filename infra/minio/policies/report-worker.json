{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReportBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::generated-reports"
    },
    {
      "Sid": "WriteGeneratedReportsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::generated-reports/analysis-cases/*/reports/*/v*/report.pdf",
        "arn:aws:s3:::generated-reports/analysis-cases/*/reports/*/v*/report.json"
      ]
    }
  ]
}

