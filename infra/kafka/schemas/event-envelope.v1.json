{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-ai.example.local/schemas/event-envelope.v1.json",
  "title": "Bank AI Kafka event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "causation_id",
    "partition_key",
    "actor",
    "resource",
    "payload",
    "metadata"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 128
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "partition_key": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EMPLOYEE",
            "SERVICE",
            "AGENT"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "payload": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "not": {
          "pattern": "(password|secret|access_token|refresh_token|api_key|cccd|account_number|base64|ocr_text|pdf)"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "schema"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+\\.v[1-9][0-9]*$",
          "maxLength": 160
        }
      }
    }
  }
}

