{
  "$comment": "Serialization schema with core decision/status/amount conditionals. CreditAnalysisResultV1.model_validate remains authoritative for evidence referential integrity and other cross-collection invariants.",
  "$defs": {
    "AgentMetadata": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "const": "credit_agent",
          "default": "credit_agent",
          "title": "Agent Id",
          "type": "string"
        },
        "agent_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Agent Version",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "agent_version",
        "run_id"
      ],
      "title": "AgentMetadata",
      "type": "object"
    },
    "CashflowAnalysis": {
      "additionalProperties": false,
      "properties": {
        "average_monthly_inflow": {
          "format": "decimal",
          "pattern": "^(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Average Monthly Inflow",
          "type": "string"
        },
        "average_monthly_outflow": {
          "format": "decimal",
          "pattern": "^(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Average Monthly Outflow",
          "type": "string"
        },
        "inflow_volatility": {
          "format": "decimal",
          "pattern": "^(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Inflow Volatility",
          "type": "string"
        },
        "largest_counterparty_share": {
          "format": "decimal",
          "pattern": "^(?:0(?:\\.\\d+)?|1(?:\\.0+)?)$",
          "title": "Largest Counterparty Share",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "assessment": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Assessment",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "average_monthly_inflow",
        "average_monthly_outflow",
        "inflow_volatility",
        "largest_counterparty_share",
        "currency",
        "assessment",
        "evidence_ids"
      ],
      "title": "CashflowAnalysis",
      "type": "object"
    },
    "CollateralAnalysis": {
      "additionalProperties": false,
      "properties": {
        "eligible_value": {
          "format": "decimal",
          "pattern": "^(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Eligible Value",
          "type": "string"
        },
        "coverage_ratio": {
          "format": "decimal",
          "pattern": "^(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Coverage Ratio",
          "type": "string"
        },
        "valuation_status": {
          "title": "Valuation Status",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "eligible_value",
        "coverage_ratio",
        "valuation_status",
        "currency",
        "evidence_ids"
      ],
      "title": "CollateralAnalysis",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "condition_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Condition Code",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/ConditionStage"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "condition_code",
        "description",
        "blocking",
        "stage",
        "evidence_ids"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionStage": {
      "enum": [
        "BEFORE_APPROVAL_REVIEW",
        "BEFORE_DISBURSEMENT",
        "ONGOING_COVENANT"
      ],
      "title": "ConditionStage",
      "type": "string"
    },
    "DataConflict": {
      "additionalProperties": false,
      "properties": {
        "conflict_code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Conflict Code",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        },
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "conflict_code",
        "description",
        "evidence_ids"
      ],
      "title": "DataConflict",
      "type": "object"
    },
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "overall_status": {
          "$ref": "#/$defs/QualityStatus"
        },
        "evidence_coverage": {
          "format": "decimal",
          "pattern": "^(?:0(?:\\.\\d+)?|1(?:\\.0+)?)$",
          "title": "Evidence Coverage",
          "type": "string"
        },
        "freshness_status": {
          "$ref": "#/$defs/FreshnessStatus"
        },
        "conflicts_detected": {
          "minimum": 0,
          "title": "Conflicts Detected",
          "type": "integer"
        },
        "datasets": {
          "additionalProperties": {
            "$ref": "#/$defs/DatasetQuality"
          },
          "title": "Datasets",
          "type": "object"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/DataConflict"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "required": [
        "overall_status",
        "evidence_coverage",
        "freshness_status",
        "conflicts_detected"
      ],
      "title": "DataQuality",
      "type": "object"
    },
    "DatasetQuality": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/QualityStatus"
        },
        "freshness": {
          "$ref": "#/$defs/FreshnessStatus"
        },
        "details": {
          "items": {
            "type": "string"
          },
          "title": "Details",
          "type": "array"
        }
      },
      "required": [
        "status",
        "freshness"
      ],
      "title": "DatasetQuality",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "READY_FOR_APPROVAL_REVIEW",
        "PASS_WITH_CONDITIONS",
        "NEEDS_INFO",
        "MANUAL_REVIEW",
        "NOT_RECOMMENDED",
        "SYSTEM_EXCEPTION"
      ],
      "title": "Decision",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "claim_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "source_system": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source System",
          "type": "string"
        },
        "source_reference": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Reference",
          "type": "string"
        },
        "as_of_date": {
          "format": "date",
          "title": "As Of Date",
          "type": "string"
        },
        "fact": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Fact",
          "type": "string"
        },
        "tool_run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tool Run Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "claim_id",
        "source_system",
        "source_reference",
        "as_of_date",
        "fact",
        "tool_run_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FacilityAnalysis": {
      "additionalProperties": false,
      "properties": {
        "current_limit": {
          "format": "decimal",
          "pattern": "^(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Current Limit",
          "type": "string"
        },
        "outstanding": {
          "format": "decimal",
          "pattern": "^(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Outstanding",
          "type": "string"
        },
        "utilization_ratio": {
          "format": "decimal",
          "pattern": "^(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Utilization Ratio",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "current_limit",
        "outstanding",
        "utilization_ratio",
        "currency",
        "evidence_ids"
      ],
      "title": "FacilityAnalysis",
      "type": "object"
    },
    "FinancialMetricsData": {
      "additionalProperties": false,
      "properties": {
        "formula_version": {
          "minLength": 1,
          "title": "Formula Version",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricValue"
          },
          "maxProperties": 128,
          "minProperties": 1,
          "title": "Metrics",
          "type": "object"
        },
        "missing_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Missing Inputs",
          "type": "array"
        },
        "non_computable_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Non Computable Metrics",
          "type": "array"
        }
      },
      "required": [
        "formula_version",
        "metrics"
      ],
      "title": "FinancialMetricsData",
      "type": "object"
    },
    "FollowUpQuestion": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "why_it_matters": {
          "title": "Why It Matters",
          "type": "string"
        },
        "expected_evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Evidence",
          "type": "array"
        },
        "blocking_if_unanswered": {
          "title": "Blocking If Unanswered",
          "type": "boolean"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "question",
        "why_it_matters",
        "expected_evidence",
        "blocking_if_unanswered"
      ],
      "title": "FollowUpQuestion",
      "type": "object"
    },
    "FreshnessStatus": {
      "enum": [
        "FRESH",
        "STALE",
        "MIXED",
        "UNKNOWN"
      ],
      "title": "FreshnessStatus",
      "type": "string"
    },
    "InfoRequest": {
      "additionalProperties": false,
      "properties": {
        "message_type": {
          "const": "INFO_REQUEST",
          "default": "INFO_REQUEST",
          "title": "Message Type",
          "type": "string"
        },
        "target_agent": {
          "enum": [
            "compliance_agent",
            "document_intelligence_agent"
          ],
          "title": "Target Agent",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "target_agent",
        "reason"
      ],
      "title": "InfoRequest",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "anyOf": [
            {
              "format": "decimal",
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current"
        },
        "prior": {
          "anyOf": [
            {
              "format": "decimal",
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prior"
        },
        "change": {
          "anyOf": [
            {
              "format": "decimal",
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change"
        },
        "plan": {
          "anyOf": [
            {
              "format": "decimal",
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "plan_variance": {
          "anyOf": [
            {
              "format": "decimal",
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Variance"
        },
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "formula": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Formula",
          "type": "string"
        },
        "input_references": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Input References",
          "type": "array"
        }
      },
      "required": [
        "unit",
        "formula",
        "input_references"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "NextAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "target_agent": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Agent",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "const": "DRY_RUN",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "action",
        "target_agent"
      ],
      "title": "NextAction",
      "type": "object"
    },
    "PolicyCitation": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "section": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "effective_from": {
          "format": "date",
          "title": "Effective From",
          "type": "string"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "status": {
          "$ref": "#/$defs/PolicyStatus"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "version",
        "section",
        "effective_from",
        "status",
        "claim_ids"
      ],
      "title": "PolicyCitation",
      "type": "object"
    },
    "PolicyStatus": {
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "EXPIRED",
        "NOT_YET_EFFECTIVE",
        "DRAFT"
      ],
      "title": "PolicyStatus",
      "type": "string"
    },
    "QualityStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED",
        "NOT_ASSESSED"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "recommended_limit": {
          "anyOf": [
            {
              "format": "decimal",
              "pattern": "^(?:0*(?:[1-9]\\d*)(?:\\.\\d+)?|0*\\.\\d*[1-9]\\d*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Limit"
        },
        "recommended_tenor_months": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Tenor Months"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "human_approval_required": {
          "const": true,
          "default": true,
          "title": "Human Approval Required",
          "type": "boolean"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "decision",
        "summary"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RelationshipAnalysis": {
      "additionalProperties": false,
      "properties": {
        "years_with_bank": {
          "format": "decimal",
          "pattern": "^(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Years With Bank",
          "type": "string"
        },
        "internal_rating": {
          "title": "Internal Rating",
          "type": "string"
        },
        "relationship_status": {
          "title": "Relationship Status",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "years_with_bank",
        "internal_rating",
        "relationship_status",
        "evidence_ids"
      ],
      "title": "RelationshipAnalysis",
      "type": "object"
    },
    "RepaymentAnalysis": {
      "additionalProperties": false,
      "properties": {
        "lookback_months": {
          "title": "Lookback Months",
          "type": "integer"
        },
        "late_payment_count": {
          "title": "Late Payment Count",
          "type": "integer"
        },
        "max_days_past_due": {
          "title": "Max Days Past Due",
          "type": "integer"
        },
        "current_days_past_due": {
          "title": "Current Days Past Due",
          "type": "integer"
        },
        "restructured_debt": {
          "title": "Restructured Debt",
          "type": "boolean"
        },
        "assessment": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Assessment",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "lookback_months",
        "late_payment_count",
        "max_days_past_due",
        "current_days_past_due",
        "restructured_debt",
        "assessment",
        "evidence_ids"
      ],
      "title": "RepaymentAnalysis",
      "type": "object"
    },
    "ResultStatus": {
      "enum": [
        "COMPLETED",
        "NEEDS_INFO",
        "SYSTEM_EXCEPTION"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "RiskCode": {
      "enum": [
        "REV_TXN_MISMATCH",
        "PROFIT_CASHFLOW_MISMATCH",
        "RECEIVABLES_SPIKE",
        "INVENTORY_SPIKE",
        "RECENT_DELINQUENCY",
        "RESTRUCTURED_DEBT",
        "LOW_LIMIT_UTILIZATION",
        "HIGH_CUSTOMER_CONCENTRATION",
        "RELATED_PARTY_FLOW",
        "STALE_COLLATERAL_VALUATION",
        "FINANCIAL_DATA_CONFLICT",
        "MISSING_LATEST_FINANCIALS",
        "INTERNAL_RATING_OUTSIDE_POLICY",
        "RELATIONSHIP_STATUS_OUTSIDE_POLICY",
        "OVER_LIMIT_EXPOSURE",
        "COLLATERAL_STATUS_OUTSIDE_POLICY",
        "STALE_INTERNAL_RATING",
        "REPEATED_LATE_PAYMENTS",
        "HIGH_INFLOW_VOLATILITY",
        "LOW_TRANSACTION_CASH_COVERAGE"
      ],
      "title": "RiskCode",
      "type": "string"
    },
    "RiskFlag": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/RiskCode"
        },
        "severity": {
          "$ref": "#/$defs/RiskSeverity"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "requires_clarification": {
          "title": "Requires Clarification",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "severity",
        "description",
        "evidence_ids",
        "requires_clarification"
      ],
      "title": "RiskFlag",
