# Copy this file to .env. Never commit the real .env or an API key.
#
# The endpoint and authentication header vary by FPT AI tenant. Obtain the
# exact chat-completions URL and supported model identifier from your FPT
# console/contract, then replace the placeholder values below.

FPT_GLM_API_KEY=replace_with_your_fpt_api_key
# FPT AI Marketplace global endpoint. Use the regional endpoint specified by
# FPT if your key belongs to another region.
FPT_GLM_CHAT_COMPLETIONS_URL=https://mkp-api.fptcloud.com/chat/completions
# Used only by --list-models to verify which model IDs your key can access.
FPT_GLM_MODELS_URL=https://mkp-api.fptcloud.com/v1/models
FPT_GLM_MODEL=GLM-5.2

# Typical OpenAI-compatible authentication. If FPT provides a different
# scheme, for example api_key with no prefix, update both values.
FPT_GLM_API_KEY_HEADER=Authorization
FPT_GLM_API_KEY_PREFIX=Bearer
FPT_GLM_TIMEOUT_SECONDS=90

# The evaluator sends the selected case and agent result to the configured
# external LLM. Keep false unless your data-sharing, privacy, and vendor
# approval process explicitly permits it. The checked-in demo is synthetic.
CREDIT_EVAL_ALLOW_EXTERNAL_CASE_DATA=false
# Leave false unless your approved FPT setup uses a custom HTTPS gateway.
CREDIT_EVAL_ALLOW_CUSTOM_ENDPOINT=false
