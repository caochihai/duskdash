# Base URL của backend API. Chỉ được sử dụng khi VITE_USE_MOCK_API=false.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Bật mock API để chạy demo frontend khi chưa có backend.
# true  -> toàn bộ dữ liệu lấy từ src/services/mockApi.ts
# false -> gọi backend thật qua Axios (src/services/apiClient.ts)
VITE_USE_MOCK_API=false

# Public OIDC client. Do not place a client secret in frontend configuration.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=bank-ai
VITE_KEYCLOAK_CLIENT_ID=bank-ai-frontend

# Thông tin ứng dụng
VITE_APP_NAME=SHB AI Assistant
VITE_APP_ENV=development